# Copy to `.env` for local use only. Replace placeholders locally; never commit secrets.

# =================================================
# AI Providers and LLMs
# =================================================

# LEARNING_GENERATION_PROVIDER
# Options: "auto" (routes to Gemini with local fallback), "local" (Ollama/OpenAI local), "gemini"
LEARNING_GENERATION_PROVIDER=auto

# Local Open-Source LLM (Zero-Cost, No API Key Required)
# Run `ollama run llama3.2:3b` in your terminal to start Ollama
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:3b
PROVIDER_FALLBACK_ENABLED=true

# GEMINI_API_KEY (Optional if using local Ollama model)
# What: Google Gemini API key for hosted inference
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# =================================================
# Core API Configuration
# =================================================

# KOGNIQ_API_ENVIRONMENT
# What: Target runtime environment (development, test, benchmark, production).
# Required: No (defaults to development)
# Example: development
KOGNIQ_API_ENVIRONMENT="development"

# KOGNIQ_API_LOG_LEVEL
# What: Minimum log severity level to capture.
# Required: No (defaults to info)
# Example: info
KOGNIQ_API_LOG_LEVEL="info"

# KOGNIQ_API_CORS_ORIGINS
# What: JSON array of allowed origins for Cross-Origin Resource Sharing.
# Required: No
# Example: '["http://localhost:3000"]'
KOGNIQ_API_CORS_ORIGINS=["http://localhost:3000"]

# =================================================
# Persistence
# =================================================

# PERSISTENCE_PROVIDER
# What: The database provider to use. Currently only sqlite is supported.
# Required: No (defaults to sqlite)
# Example: sqlite
PERSISTENCE_PROVIDER=sqlite

# SQLITE_DATABASE_PATH
# What: The path/filename for the SQLite database.
# Required: No (defaults to kogniq.sqlite)
# Example: kogniq_dev.sqlite
SQLITE_DATABASE_PATH=kogniq.sqlite
