# Mode for live API vs mock services ("live" or "mock")
NEXT_PUBLIC_PROVIDER_MODE=live

# URL of the deployed FastAPI backend (e.g., on Render, Railway, Fly.io, AWS, or VPS)
# When deploying to Vercel, configure this in the Vercel Dashboard under Settings -> Environment Variables.
# For local development, defaults to http://127.0.0.1:8000 if not specified.
BACKEND_URL=https://your-backend-api.onrender.com
